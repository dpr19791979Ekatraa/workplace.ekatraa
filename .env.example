# ─────────────────────────────────────────────────────────────────────
# ekatraa — local development environment template
# Copy this file to `.env` and fill in real values.
# DO NOT commit `.env` — it is gitignored.
# In Replit, secrets live in the Secrets manager, not in this file.
# ─────────────────────────────────────────────────────────────────────

# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info

# Postgres connection string (use a local Postgres or Neon/Supabase URL)
DATABASE_URL=postgres://user:password@localhost:5432/ekatraa

# Express session signing secret (any long random string)
SESSION_SECRET=replace-with-a-long-random-string

# ── Clerk auth ───────────────────────────────────────────────────────
# Get from https://dashboard.clerk.com → API Keys
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx

# Frontend (Vite) — same publishable key, exposed to the browser
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxx
# Optional: only set if you use a Clerk proxy
# VITE_CLERK_PROXY_URL=https://clerk.yourdomain.com

# ── Object storage (Replit-managed; only needed on Replit) ───────────
DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# ── WhatsApp (Interakt) ──────────────────────────────────────────────
# Get from https://app.interakt.ai → Developer Settings → Secret Key (Base64)
INTERAKT_API_KEY=

# Owner notifications — your own WhatsApp for system alerts
OWNER_EMAIL=owner@example.com
OWNER_WHATSAPP_COUNTRY_CODE=+91
OWNER_WHATSAPP_NUMBER=9999999999

# Approved Interakt template (required for first-touch messages outside
# the 24-hour session window). Leave blank to send plain text only.
INTERAKT_TEMPLATE_NAME=
INTERAKT_TEMPLATE_LANG=en
